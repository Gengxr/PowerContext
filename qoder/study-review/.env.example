# 学习回顾台 环境变量示例（复制为 .env 或直接 export；勿提交真实凭据）
# PowerContext Server 地址（scripts/start_powercontext.py 默认监听 18080）
STUDY_REVIEW_PC_URL=http://127.0.0.1:18080
# 可选 Bearer Token；本地 loopback 免认证时留空
STUDY_REVIEW_PC_TOKEN=
# 应用监听地址 / 端口
STUDY_REVIEW_HOST=127.0.0.1
STUDY_REVIEW_PORT=18081
# 逐请求审计日志路径（相对项目根）
STUDY_REVIEW_AUDIT=runtime/audit.jsonl
# 可选固定时钟（ISO8601），仅用于可复现演示/测试；留空=真实时钟
# STUDY_REVIEW_FIXED_NOW=2026-11-11T09:00:00Z